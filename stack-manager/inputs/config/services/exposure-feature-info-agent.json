{
    "ServiceSpec": {
        "Name": "exposure-feature-info-agent",
        "TaskTemplate": {
            "ContainerSpec": {
                "Image": "ghcr.io/theworldavatar/exposure-feature-info-agent:2.2.1-9-query-results-via-sql-SNAPSHOT",
                "Env": [
                    "NAMESPACE=hd4"
                ],
                "Configs": [
                    {
                        "ConfigName": "blazegraph"
                    },
                    {
                        "ConfigName": "postgis"
                    },
                    {
                        "ConfigName": "ontop"
                    },
                    {
                        "ConfigName": "rdf4j"
                    }
                ],
                "Secrets": [
                    {
                        "SecretName": "postgis_password"
                    }
                ]
            }
        }
    },
    "endpoints": {
        "rest": {
            "url": "http://localhost:8080/ExposureFeatureInfoAgent/",
            "externalPath": "/exposure-feature-info-agent/"
        }
    }
}