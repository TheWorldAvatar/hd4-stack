{
    "name": "ndvi",
    "database": "postgres",
    "workspace": "twa",
    "skip": false,
    "datasetDirectory": "ndvi",
    "dataSubsets": [
        {
            "name": "greenspace_properties",
            "skip": true,
            "type": "vector",
            "subdirectory": "greenspace_properties",
            "sql": "CREATE INDEX IF NOT EXISTS greenspace_properties_year_idx ON greenspace_properties(year)"
        },
        {
            "name": "ndvi_raster",
            "skip": true,
            "type": "raster",
            "subdirectory": "raster",
            "sql": "@/inputs/data/ndvi/sql/add_year_and_area.sql",
            "additionalMetadata": {
                "prefixes": {
                    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
                    "exposure": "https://www.theworldavatar.com/kg/ontoexposure/",
                    "xsd": "http://www.w3.org/2001/XMLSchema#"
                },
                "triplePatterns": "?dataSubset exposure:hasGeometryColumn 'rast'; exposure:hasAreaColumn 'area'; rdfs:label 'NDVI'."
            }
        },
        {
            "name": "ndvi_raster_with_properties",
            "type": "vector",
            "skip": true,
            "sql": "@/inputs/data/ndvi/sql/clip_raster.sql",
            "additionalMetadata": {
                "prefixes": {
                    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
                    "exposure": "https://www.theworldavatar.com/kg/ontoexposure/",
                    "xsd": "http://www.w3.org/2001/XMLSchema#"
                },
                "triplePatterns": "?dataSubset exposure:hasGeometryColumn 'rast'; exposure:hasAreaColumn 'area'; rdfs:label 'NDVI with properties'."
            }
        }
    ]
}