{
    "name": "building",
    "database": "postgres",
    "workspace": "twa",
    "skip": false,
    "datasetDirectory": "building",
    "dataSubsets": [
        {
            "name": "gvi",
            "skip": false,
            "type": "vector",
            "subdirectory": "gvi",
            "ogr2ogrOptions": {
                "sridIn": "EPSG:3414",
                "sridOut": "EPSG:4326",
                "layerCreationOptions": {"GEOMETRY_NAME": "wkb_geometry"}
            },
            "additionalMetadata": {
                "prefixes": {
                    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
                    "exposure": "https://www.theworldavatar.com/kg/ontoexposure/",
                    "xsd": "http://www.w3.org/2001/XMLSchema#"
                },
                "triplePatterns": "?dataSubset rdfs:label 'GGVA'."
            }
        },
        {
            "name": "buildings_layer",
            "skip": true,
            "sql": "@/inputs/data/building/buildings_layer/buildings_layer.sql",
            "type": "vector"
        }
    ]
}